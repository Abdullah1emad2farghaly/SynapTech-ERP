# Intended project path: .env.example (append these lines to the existing file)
#
# Firebase project used ONLY for temporary WebRTC signaling (Mobile Barcode
# Scanner POC). Requires: Realtime Database enabled + Anonymous
# Authentication provider enabled. Both are available on Firebase's free
# Spark plan — no billing account required.
#
# Get these from: Firebase Console → Project Settings → General → Your apps
# → SDK setup and configuration. VITE_FIREBASE_DATABASE_URL is the Realtime
# Database URL specifically (Firebase Console → Realtime Database → top of
# the Data tab, looks like https://<project-id>-default-rtdb.<region>.firebasedatabase.app),
# NOT the Firestore URL.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
